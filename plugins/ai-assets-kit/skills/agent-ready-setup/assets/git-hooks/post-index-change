#!/bin/sh
# agent-ready-setup: relinks .claude hard-link views detached by git.
#
# Fallback for git versions without config-based hooks (hook.<name>.event): agent-ready
# then installs this file as .git/hooks/post-index-change. The relink logic lives in the
# projected .agents/hooks/relink-hard-link-views.sh, shared with the Claude Code hook.
project_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
relink_script="$project_root/.agents/hooks/relink-hard-link-views.sh"
[ -f "$relink_script" ] || exit 0
exec sh "$relink_script"
